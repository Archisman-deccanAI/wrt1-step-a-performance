# Copy this file to .env.local and fill in the values.
# The Firebase WEB config below is not secret (it ships in the client bundle),
# but keep .env.local out of git anyway.

VITE_DATA_MODE=firebase
# use "seed" to run entirely on bundled sample data, no Firebase needed

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=wrt1-performance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wrt1-performance
VITE_FIREBASE_APP_ID=your-web-app-id

# comma-separated list of email domains allowed to sign in
VITE_ALLOWED_DOMAINS=deccanteam.us,teamdeccan.com,deccan.ai
